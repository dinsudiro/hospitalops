rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function orgPath(orgId) {
      return /databases/$(database)/documents/hospitalopsOrganizations/$(orgId);
    }
    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/hospitalopsOrganizations/$(orgId)/members/$(uid);
    }
    function member(orgId) {
      return signedIn() && exists(memberPath(orgId, request.auth.uid));
    }
    function owner(orgId) {
      return signedIn() && get(orgPath(orgId)).data.ownerUid == request.auth.uid;
    }

    match /hospitalopsOrganizations/{orgId} {
      allow get: if member(orgId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'name'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && getAfter(memberPath(orgId, request.auth.uid)).data.role == 'owner';

      match /members/{uid} {
        allow get: if signedIn() && (uid == request.auth.uid || owner(orgId));
        allow create: if request.resource.data.keys().hasOnly(['role'])
          && ((owner(orgId) && request.resource.data.role == 'manager')
              || (signedIn() && uid == request.auth.uid
                  && !exists(orgPath(orgId))
                  && getAfter(orgPath(orgId)).data.ownerUid == uid
                  && request.resource.data.role == 'owner'));
      }

      match /entries/{entryId} {
        allow read, delete: if member(orgId);
        allow create, update: if member(orgId)
          && request.resource.data.keys().hasOnly(['payload'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 250000;
      }
    }

    match /hospitalopsUsers/{uid}/organizations/{orgId} {
      allow read, delete: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && getAfter(memberPath(orgId, uid)).data.role in ['owner', 'manager']
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == getAfter(orgPath(orgId)).data.name;
    }
  }
}
